PORT=5001
# Extra allowed website origins, comma-separated (localhost and *.vercel.app are always allowed)
CLIENT_ORIGIN=
# Local SQLite file used when TURSO_DATABASE_URL is empty (relative to server/, absolute, or :memory:)
DB_PATH=./database/energize.db
# Optional: hosted Turso database for permanent data (free tier). Leave empty to use the local file.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
# Max write requests (scores, suggestions, contact) per IP per minute
RATE_LIMIT_MAX=20
